ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
PORT=3001
VITE_CHATBOT_API=http://localhost:3001
DATA_ROOM_CHAT_URL=https://dataroom.moi.technology/api/chat
ALLOWED_ORIGINS=http://localhost:5173,https://moi.technology
ADMIN_API_KEY=your-secret-admin-key

# --- Blog distribution ------------------------------------------------------
# Set these as GitHub repository secrets, not in a local .env — they are only
# read by the Distribute workflow. A channel whose secrets are absent is
# skipped and reported, so this can be switched on one channel at a time.
#
# Discord: Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=
# Telegram: @BotFather /newbot, then add the bot to the channel as an admin
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Buffer: only an organisation owner can create an API key. Turn on post
# approval for the X and LinkedIn channels — that setting, not the code, is
# what stops a queued draft publishing on its own.
BUFFER_ACCESS_TOKEN=
BUFFER_CHANNEL_X=
BUFFER_CHANNEL_LINKEDIN=
