ANTHROPIC_API_KEY=your_anthropic_api_key
OPENAI_API_KEY=your_openai_api_key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_or_service_key
PORT=3001
VITE_CHATBOT_API=http://localhost:3001
DATA_ROOM_CHAT_URL=https://dataroom.moi.technology/api/chat
ALLOWED_ORIGINS=http://localhost:5173,https://moi.technology
ADMIN_API_KEY=your-secret-admin-key

# ── Analytics ──
# Same GA4 measurement ID in both: one property covers moi.technology and
# blog.moi.technology, so a session that crosses hosts stays one session.
# Leave unset locally — analytics only load on the production hostnames.
VITE_GA_ID=G-XXXXXXXXXX        # marketing site (Vite)
PUBLIC_GA_ID=G-XXXXXXXXXX      # blog (Astro), set in the blog build env
# Only needed if verifying Search Console by meta tag instead of DNS.
PUBLIC_GSC_VERIFICATION=
