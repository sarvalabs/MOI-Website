---
// Google Tag Manager. GA4 is configured as a tag inside the container rather
// than hardcoded here, so marketing can add or change tracking without a code
// change and a deploy.
//
// Deliberately not hostname-gated in code: the noscript iframe cannot be, so
// the guard belongs in GTM instead. The GA4 tag's trigger is conditioned on
// Page Hostname, which covers both paths and keeps previews out of the
// production property.
const gtmId = 'GTM-M4BR46Z2';
---

<script is:inline define:vars={{ gtmId }}>
  (function (w, d, s, l, i) {
    w[l] = w[l] || [];
    w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
    var f = d.getElementsByTagName(s)[0],
      j = d.createElement(s),
      dl = l != 'dataLayer' ? '&l=' + l : '';
    j.async = true;
    j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
    f.parentNode.insertBefore(j, f);
  })(window, document, 'script', 'dataLayer', gtmId);
</script>
