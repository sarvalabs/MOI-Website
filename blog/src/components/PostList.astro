---
const { posts } = Astro.props;
const base = import.meta.env.BASE_URL;
const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

<div class="post-list">
  {
    posts.map((post) => (
      <article class="post-row">
        <div class="micro meta">
          <span>Article</span>
          <span class="sep" aria-hidden="true">
            •
          </span>
          <time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
          {post.data.tags.map((t) => (
            <>
              <span class="sep" aria-hidden="true">
                •
              </span>
              <a href={`${base}/tags/${t}/`}>{t}</a>
            </>
          ))}
        </div>
        <h2>
          <a href={`${base}/posts/${post.id}/`}>{post.data.title}</a>
        </h2>
        <p class="sub">{post.data.summary}</p>
        {post.data.author && <p class="micro authors">{post.data.author.name}</p>}
      </article>
    ))
  }
</div>

<style>
  .post-list {
    display: grid;
  }

  .post-row {
    border-top: 1px solid var(--line-strong);
    padding: 18px 0 34px;
  }

  .meta {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 10px;
  }

  .meta a {
    color: var(--muted);
    text-decoration: none;
  }

  .meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .sep {
    color: var(--line);
  }

  h2 {
    font-family: var(--font-generic);
    font-weight: 400;
    font-size: clamp(28px, 4vw, 40px);
    line-height: 1.12;
    margin: 14px 0 10px;
    text-wrap: balance;
    max-width: 26ch;
  }

  h2 a {
    text-decoration: none;
  }

  h2 a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
  }

  .sub {
    margin: 0;
    color: var(--muted);
    font-size: 15px;
    max-width: 58ch;
  }

  .authors {
    margin: 14px 0 0;
  }
</style>
