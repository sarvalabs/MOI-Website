---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';

const { title, description, ogType = 'website', navTitle = 'Blog' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MOI Blog"
      href={`${base}/rss.xml`}
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="nav-pill">
        <a class="nav-logo" href="https://moi.technology/" aria-label="MOI — home">
          <img src={`${base}/brand/logos/SVG/default-light.svg`} alt="MOI" />
        </a>
        <nav class="nav-center">
          <a href="https://moi.technology/why-moi">The Shift</a>
          <a href="https://docs.moi.technology" target="_blank" rel="noopener noreferrer">Docs</a>
          <a href="https://moi.technology/manifesto">Manifesto</a>
          <a href="https://moi.technology/papers">Papers</a>
          <a class="nav-active" href={`${base}/`}>Blog</a>
        </nav>
        <span class="nav-title" id="nav-title">{navTitle}</span>
        <a class="nav-cta" href="https://voyage.moi.technology" target="_blank" rel="noopener noreferrer">Explore the network</a>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Sarva Labs — MOI</span>
        <span>Not your Context, Not your Agent.</span>
      </div>
    </footer>

    <script is:inline>
      // navbar adopts the page title once the hero scrolls past
      (function () {
        var header = document.getElementById('site-header');
        var hero = document.querySelector('[data-hero]');
        if (!hero) {
          header.classList.add('condensed');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            header.classList.toggle('condensed', !entries[0].isIntersecting);
          },
          { rootMargin: '-96px 0px 0px 0px' }
        );
        io.observe(hero);
      })();
    </script>
  </body>
</html>
