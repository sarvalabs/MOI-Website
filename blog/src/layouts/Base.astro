---
import '../styles/global.css';

const { title, description, ogType = 'website', navTitle = 'The MOI Blog' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MOI Blog"
      href={`${base}/rss.xml`}
    />
    <script is:inline>
      // apply saved reader font before paint (LSD-style generic font switch)
      (function () {
        var f = localStorage.getItem('moi-blog-font');
        if (f) document.documentElement.setAttribute('data-font', f);
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="wrap">
        <a class="brand" href={`${base}/`}>MOI &nbsp;/&nbsp; Blog</a>
        <span class="nav-title" id="nav-title">{navTitle}</span>
        <nav class="site-nav">
          <a href="https://moi.technology/">moi.technology</a>
          <a href={`${base}/rss.xml`}>RSS</a>
          <div class="font-switch" role="group" aria-label="Reading font">
            <button class="f-serif" data-font="serif" aria-pressed="true" title="Serif">Aa</button>
            <button class="f-sans" data-font="sans-serif" aria-pressed="false" title="Sans serif">Aa</button>
            <button class="f-mono" data-font="monospace" aria-pressed="false" title="Monospace">Aa</button>
          </div>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap micro">
        <span>© {new Date().getFullYear()} Sarva Labs — MOI</span>
        <span>Not your Context, Not your Agent.</span>
      </div>
    </footer>

    <script is:inline>
      // font switcher
      (function () {
        var btns = document.querySelectorAll('.font-switch button');
        function apply(f) {
          if (f === 'serif') document.documentElement.removeAttribute('data-font');
          else document.documentElement.setAttribute('data-font', f);
          localStorage.setItem('moi-blog-font', f === 'serif' ? '' : f) ||
            (f === 'serif' && localStorage.removeItem('moi-blog-font'));
          btns.forEach(function (b) {
            b.setAttribute('aria-pressed', String(b.dataset.font === f));
          });
        }
        btns.forEach(function (b) {
          b.addEventListener('click', function () {
            apply(b.dataset.font);
          });
        });
        var saved = localStorage.getItem('moi-blog-font');
        if (saved) apply(saved);
      })();

      // condensing navbar: show the page title once the hero scrolls past
      (function () {
        var header = document.getElementById('site-header');
        var hero = document.querySelector('[data-hero]');
        if (!hero) {
          header.classList.add('condensed');
          return;
        }
        var io = new IntersectionObserver(
          function (entries) {
            header.classList.toggle('condensed', !entries[0].isIntersecting);
          },
          { rootMargin: '-44px 0px 0px 0px' }
        );
        io.observe(hero);
      })();
    </script>
  </body>
</html>
