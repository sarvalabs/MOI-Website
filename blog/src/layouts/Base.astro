---
import '@fontsource/instrument-serif';
import '@fontsource/dm-mono/400.css';
import '@fontsource/dm-mono/500.css';
import '../styles/global.css';

const { title, description, ogType = 'website' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MOI Blog"
      href={`${base}/rss.xml`}
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href={`${base}/`}>MOI<span>Blog</span></a>
        <nav class="site-nav">
          <a href="https://moi.technology/">moi.technology</a>
          <a href="https://moi.technology/why-moi">The Shift</a>
          <a href={`${base}/rss.xml`}>RSS</a>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Sarva Labs — MOI</span>
        <span>Not your Context, Not your Agent.</span>
      </div>
    </footer>
  </body>
</html>
