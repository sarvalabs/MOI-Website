---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/500.css';
import '@fontsource/poppins/600.css';
import '@fontsource/poppins/700.css';
import '../styles/global.css';
import { getCollection } from 'astro:content';

const { title, description, ogType = 'website', navTitle = 'Blog' } = Astro.props;

// The masthead's topics are derived from what is actually published, so the nav
// can never advertise a tag with nothing behind it. Top three by post count.
const navCounts = new Map();
for (const p of await getCollection('posts', ({ data }) => !data.draft)) {
  for (const t of p.data.tags) navCounts.set(t, (navCounts.get(t) ?? 0) + 1);
}
const navTopics = [...navCounts.entries()]
  .sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))
  .slice(0, 3)
  .map(([t]) => t);
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- The blog declared no icon at all, so browsers fell back to a generic
         globe. default-light is the purple-planet mark and the only file under
         brand/logos/SVG whose stylesheet is intact; the rest render black. -->
    <link rel="icon" type="image/svg+xml" href="/brand/logos/SVG/default-light.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="MOI Blog"
      href={`/rss.xml`}
    />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header" id="site-header">
      <div class="nav-shell">
        <div class="nav-pill" id="nav-pill" aria-expanded="true">
          <a class="nav-brand" href="https://moi.technology/" aria-label="MOI — moi.technology">
            <img src="/brand/logos/SVG/default-light.svg" alt="MOI" />
            <span class="nav-wordmark">MOI <span>Blog</span></span>
          </a>
          <div class="nav-right">
            <nav class="nav-topics" aria-label="Topics">
              {navTopics.map((t) => <a href={`/tags/${t}/`}>{t}</a>)}
            </nav>
            <span class="nav-rule" aria-hidden="true"></span>
            <a class="nav-rss" href="/rss.xml" aria-label="RSS feed" title="RSS">
              <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <circle cx="6.2" cy="17.8" r="2.2"></circle>
                <path d="M4 10.6v3a6.4 6.4 0 0 1 6.4 6.4h3A9.4 9.4 0 0 0 4 10.6z"></path>
                <path d="M4 4v3a13 13 0 0 1 13 13h3A16 16 0 0 0 4 4z"></path>
              </svg>
            </a>
          </div>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Sarva Labs — MOI</span>
      </div>
    </footer>

    <script is:inline>
      // jelly navbar: scrolling past the hero collapses the pill from the
      // right toward the MOI logo; clicking the collapsed pill re-expands it,
      // scrolling again re-collapses.
      (function () {
        var header = document.getElementById('site-header');
        var pill = document.getElementById('nav-pill');
        var hero = document.querySelector('[data-hero]');
        var pinnedOpen = false;
        var pastHero = false;

        function setCollapsed(v) {
          header.classList.toggle('collapsed', v);
          pill.setAttribute('aria-expanded', String(!v));
        }

        if (hero) {
          new IntersectionObserver(
            function (entries) {
              pastHero = !entries[0].isIntersecting;
              if (!pastHero) pinnedOpen = false;
              if (!pinnedOpen) setCollapsed(pastHero);
            },
            { rootMargin: '-96px 0px 0px 0px' }
          ).observe(hero);
        } else {
          pastHero = true;
          setCollapsed(true);
        }

        pill.addEventListener('click', function (ev) {
          if (header.classList.contains('collapsed')) {
            ev.preventDefault();
            ev.stopPropagation();
            pinnedOpen = true;
            setCollapsed(false);
          }
        });

        var lastY = window.scrollY;
        window.addEventListener(
          'scroll',
          function () {
            var dy = Math.abs(window.scrollY - lastY);
            lastY = window.scrollY;
            if (pinnedOpen && pastHero && dy > 8) {
              pinnedOpen = false;
              setCollapsed(true);
            }
          },
          { passive: true }
        );
      })();
    </script>
  </body>
</html>
