---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tagCounts = new Map();
for (const p of posts) for (const t of p.data.tags) tagCounts.set(t, (tagCounts.get(t) ?? 0) + 1);
const tags = [...tagCounts.entries()].sort((a, b) => b[1] - a[1]);
const base = import.meta.env.BASE_URL;
---

<Base
  title="The MOI Blog — Contextual Compute, agents, and on-chain authority"
  description="Writing from Sarva Labs on MOI: Contextual Compute, agent authority, protocol research, and product updates."
>
  <div class="wrap">
    <section class="hero" data-hero>
      <h1>
        <span>The</span>
        <span>MOI</span>
        <span>Blog</span>
      </h1>
      <p class="hero-desc">
        Contextual Compute, agent authority, protocol research, and product updates —
        from the team building the personal internet.
      </p>
      <nav class="tag-row" aria-label="Filter by tag">
        <a class="tag-pill active" href={`${base}/`}>All</a>
        {tags.map(([t, n]) => <a class="tag-pill" href={`${base}/tags/${t}/`}>{t} · {n}</a>)}
      </nav>
    </section>

    <PostList posts={posts} />
  </div>
</Base>

<style>
  .hero {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    padding: 84px 0 72px;
    text-align: center;
  }

  h1 {
    font-family: var(--font-generic);
    font-weight: 400;
    font-size: clamp(56px, 11vw, 120px);
    line-height: 0.94;
    letter-spacing: 0.01em;
    text-transform: uppercase;
    margin: 0;
    display: flex;
    flex-direction: column;
  }

  .hero-desc {
    max-width: 46ch;
    margin: 0;
    font-size: 15px;
    color: var(--muted);
  }

  @media (max-width: 768px) {
    .hero {
      padding: 40px 0 48px;
    }
  }
</style>
