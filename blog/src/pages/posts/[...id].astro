---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, updated, author, tags, takeaways, faq } = post.data;
const base = import.meta.env.BASE_URL;

const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: summary,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: author
      ? { '@type': 'Organization', name: author.name, url: author.url }
      : undefined,
    keywords: tags.join(', '),
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  },
  faq && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
].filter(Boolean);
---

<Base title={`${title} — MOI Blog`} description={summary} ogType="article">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="wrap">
    <header class="post-head">
      <p class="eyebrow">
        <a href={`${base}/`}>← All posts</a>
      </p>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      <div class="byline">
        {author && (
          <span>
            {author.url ? <a href={author.url}>{author.name}</a> : author.name}
            {author.role && <em> — {author.role}</em>}
          </span>
        )}
        <time datetime={date.toISOString()}>{fmt(date)}</time>
        {updated && updated.valueOf() !== date.valueOf() && (
          <span class="updated">Updated {fmt(updated)}</span>
        )}
      </div>
    </header>

    {
      takeaways && (
        <aside class="takeaways" aria-label="Key takeaways">
          <p class="eyebrow">Key takeaways</p>
          <ul>
            {takeaways.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      faq && (
        <section class="faq" aria-label="Frequently asked questions">
          <h2>FAQ</h2>
          {faq.map(({ q, a }) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </section>
      )
    }

    <footer class="post-foot">
      <div class="tag-row">
        {tags.map((t) => (
          <a class="tag-pill" href={`${base}/tags/${t}/`}>
            {t}
          </a>
        ))}
      </div>
    </footer>
  </article>
</Base>

<style>
  .post-head {
    padding: 56px 0 8px;
  }

  .post-head h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(34px, 6vw, 50px);
    line-height: 1.08;
    letter-spacing: -0.01em;
    margin: 0 0 14px;
    text-wrap: balance;
  }

  .post-head .eyebrow a {
    text-decoration: none;
    color: var(--ink-2);
  }

  .summary {
    color: var(--ink-2);
    font-size: 15.5px;
    max-width: 58ch;
    margin: 0 0 18px;
  }

  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 18px;
    font-size: 12px;
    color: var(--ink-2);
    border-bottom: 1px solid var(--line);
    padding-bottom: 22px;
  }

  .takeaways {
    background: var(--purple-soft);
    border-left: 3px solid var(--purple);
    border-radius: 0 8px 8px 0;
    padding: 18px 22px;
    margin: 30px 0;
  }

  .takeaways ul {
    margin: 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    font-size: 13.5px;
  }

  .faq {
    margin-top: 48px;
    border-top: 1px solid var(--line);
    padding-top: 26px;
  }

  .faq h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 28px;
    margin: 0 0 14px;
  }

  .faq details {
    background: var(--paper);
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    padding: 12px 18px;
    margin-bottom: 8px;
  }

  .faq summary {
    cursor: pointer;
    font-weight: 500;
    font-size: 14px;
  }

  .faq p {
    color: var(--ink-2);
    font-size: 13.5px;
    margin: 10px 0 4px;
  }

  .post-foot {
    margin-top: 40px;
  }
</style>

<style is:global>
  /* Article body typography — global so it reaches rendered Markdown */
  .prose {
    font-size: 15px;
  }

  .prose h2 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.15;
    margin: 44px 0 12px;
    text-wrap: balance;
  }

  .prose h3 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: 23px;
    margin: 32px 0 10px;
  }

  .prose p {
    max-width: 66ch;
  }

  .prose strong {
    font-weight: 500;
  }

  .prose blockquote {
    margin: 26px 0;
    padding: 4px 22px;
    border-left: 3px solid var(--purple);
    color: var(--ink-2);
    font-style: italic;
  }

  .prose pre {
    background: var(--paper) !important;
    border: 1px solid var(--line-soft);
    border-radius: 8px;
    padding: 16px 18px;
    font-size: 12.5px;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose code {
    font-family: var(--mono);
  }

  .prose :not(pre) > code {
    background: var(--wash);
    border-radius: 4px;
    padding: 1px 6px;
    font-size: 0.9em;
  }

  .prose table {
    border-collapse: collapse;
    width: 100%;
    font-size: 13px;
    margin: 24px 0;
    display: block;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--line);
    padding: 8px 12px;
    text-align: left;
  }

  .prose th {
    background: var(--wash);
    font-weight: 500;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--line-soft);
    background: var(--paper);
  }

  .prose ol,
  .prose ul {
    padding-left: 22px;
  }

  .prose li {
    margin-bottom: 6px;
  }
</style>
