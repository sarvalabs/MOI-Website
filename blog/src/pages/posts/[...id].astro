---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, summary, date, updated, author, tags, takeaways, faq } = post.data;
const base = import.meta.env.BASE_URL;

const fmt = (d) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: summary,
    datePublished: date.toISOString(),
    dateModified: (updated ?? date).toISOString(),
    author: author
      ? { '@type': 'Organization', name: author.name, url: author.url }
      : undefined,
    keywords: tags.join(', '),
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  },
  faq && {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map(({ q, a }) => ({
      '@type': 'Question',
      name: q,
      acceptedAnswer: { '@type': 'Answer', text: a },
    })),
  },
].filter(Boolean);
---

<Base title={`${title} — The MOI Blog`} description={summary} ogType="article" navTitle={title}>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <article class="wrap article">
    <header class="post-head" data-hero>
      <div class="micro meta">
        <a href={`${base}/`}>← All posts</a>
        <span class="sep" aria-hidden="true">•</span>
        <span>Article</span>
        <span class="sep" aria-hidden="true">•</span>
        <time datetime={date.toISOString()}>{fmt(date)}</time>
        {updated && updated.valueOf() !== date.valueOf() && <span>(updated {fmt(updated)})</span>}
      </div>
      <h1>{title}</h1>
      <p class="summary">{summary}</p>
      {
        author && (
          <p class="micro byline">
            {author.url ? <a href={author.url}>{author.name}</a> : author.name}
            {author.role && <span> — {author.role}</span>}
          </p>
        )
      }
    </header>

    {
      takeaways && (
        <aside class="takeaways" aria-label="Key takeaways">
          <p class="micro">Key takeaways</p>
          <ul>
            {takeaways.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </aside>
      )
    }

    <div class="prose">
      <Content />
    </div>

    {
      faq && (
        <section class="faq" aria-label="Frequently asked questions">
          <p class="micro">FAQ</p>
          {faq.map(({ q, a }) => (
            <details>
              <summary>{q}</summary>
              <p>{a}</p>
            </details>
          ))}
        </section>
      )
    }

    <footer class="post-foot">
      <div class="tag-row left">
        {tags.map((t) => (
          <a class="tag-pill" href={`${base}/tags/${t}/`}>
            {t}
          </a>
        ))}
      </div>
    </footer>
  </article>
</Base>

<style>
  .article {
    max-width: 700px;
  }

  .post-head {
    padding: 56px 0 10px;
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .meta a {
    text-decoration: none;
    color: var(--muted);
  }

  .meta a:hover {
    color: var(--ink);
    text-decoration: underline;
  }

  .sep {
    color: var(--line);
  }

  .post-head h1 {
    font-family: var(--font-generic);
    font-weight: 400;
    font-size: clamp(36px, 6vw, 54px);
    line-height: 1.08;
    margin: 18px 0 14px;
    text-wrap: balance;
  }

  .summary {
    color: var(--muted);
    font-size: 17px;
    line-height: 1.5;
    max-width: 56ch;
    margin: 0 0 16px;
  }

  .byline {
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 22px;
    margin: 0;
  }

  .takeaways {
    border: 1px solid var(--line-strong);
    padding: 18px 22px;
    margin: 32px 0;
  }

  .takeaways ul {
    margin: 10px 0 0;
    padding-left: 18px;
    display: grid;
    gap: 8px;
    font-size: 14.5px;
  }

  .faq {
    margin-top: 52px;
    border-top: 1px solid var(--line-strong);
    padding-top: 22px;
  }

  .faq details {
    border-bottom: 1px solid var(--line);
    padding: 14px 2px;
  }

  .faq summary {
    cursor: pointer;
    font-size: 16px;
  }

  .faq p {
    color: var(--muted);
    font-size: 14.5px;
    margin: 10px 0 2px;
    max-width: 60ch;
  }

  .post-foot {
    margin-top: 44px;
  }

  .tag-row.left {
    justify-content: flex-start;
  }
</style>

<style is:global>
  /* Article body — rendered Markdown, follows the reader-selected font */
  .prose {
    font-size: 16.5px;
    line-height: 1.65;
  }

  .prose h2 {
    font-family: var(--font-generic);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.15;
    margin: 48px 0 12px;
    text-wrap: balance;
  }

  .prose h3 {
    font-family: var(--font-generic);
    font-weight: 400;
    font-size: 22px;
    margin: 34px 0 10px;
  }

  .prose p {
    max-width: 66ch;
  }

  .prose blockquote {
    margin: 28px 0;
    padding: 2px 0 2px 22px;
    border-left: 1px solid var(--line-strong);
    color: var(--muted);
    font-style: italic;
  }

  .prose pre {
    background: #fff !important;
    border: 1px solid var(--line-strong);
    padding: 16px 18px;
    font-size: 13px;
    line-height: 1.6;
    overflow-x: auto;
  }

  .prose code {
    font-family: var(--font-mono);
  }

  .prose :not(pre) > code {
    border: 1px solid var(--line);
    padding: 0 5px;
    font-size: 0.85em;
  }

  .prose table {
    border-collapse: collapse;
    width: 100%;
    font-size: 14px;
    margin: 26px 0;
    display: block;
    overflow-x: auto;
  }

  .prose th,
  .prose td {
    border: 1px solid var(--line-strong);
    padding: 9px 12px;
    text-align: left;
  }

  .prose th {
    text-transform: uppercase;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    font-weight: 400;
  }

  .prose img {
    max-width: 100%;
    height: auto;
    border: 1px solid var(--line-strong);
  }

  .prose ol,
  .prose ul {
    padding-left: 22px;
  }

  .prose li {
    margin-bottom: 6px;
  }
</style>
