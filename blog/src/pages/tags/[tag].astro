---
import { getCollection } from 'astro:content';
import Base, { NAV_TOPICS } from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  // Every tag any post carries, plus the masthead's fixed topics, so a nav
  // link never 404s even before a post carries that tag.
  const tags = [...new Set([...posts.flatMap((p) => p.data.tags), ...NAV_TOPICS.map((t) => t.slug)])];
  return tags.map((tag) => ({
    params: { tag },
    props: {
      posts: posts
        .filter((p) => p.data.tags.includes(tag))
        .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()),
      allTags: tags,
    },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
const topic = NAV_TOPICS.find((t) => t.slug === tag);
---

<Base title={`${topic?.label ?? tag} — MOI Blog`} description={`Posts tagged “${topic?.label ?? tag}” on the MOI blog.`} navTitle={`Tag: ${topic?.label ?? tag}`}>
  <section class="hero haze" data-hero>
    <div class="wrap hero-inner">
      <h1>{topic?.label ?? tag}</h1>
      <nav class="tag-row center" aria-label="Filter by tag">
        <a class="tag-pill" href={`/`}>All</a>
        {
          NAV_TOPICS.map((t) => (
            <a class:list={['tag-pill', { active: t.slug === tag }]} href={`/tags/${t.slug}/`}>
              {t.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="wrap narrow">
    <PostList posts={posts} />
  </div>
</Base>

<style>
  .hero {
    margin-top: -96px;
    padding: 165px 0 72px;
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    text-align: center;
  }

  h1 {
    font-weight: 600;
    font-size: clamp(34px, 5vw, 54px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-transform: capitalize;
    margin: 0;
  }

  .tag-row.center {
    justify-content: center;
  }
</style>
