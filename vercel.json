{
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/why-moi", "destination": "/why-moi/index.html" },
    { "source": "/how-it-works", "destination": "/index.html" },
    { "source": "/manifesto", "destination": "/manifesto/index.html" },
    { "source": "/papers", "destination": "/papers/index.html" },
    { "source": "/blog", "destination": "/blog/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Link", "value": "</llms.txt>; rel=\"llms-txt\", <https://docs.moi.technology/.well-known/agent-skills/index.json>; rel=\"service-meta\"" }
      ]
    },
    {
      "source": "/papers/(.*).pdf",
      "headers": [
        { "key": "Content-Disposition", "value": "attachment" }
      ]
    }
  ]
}
